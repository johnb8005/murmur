# Murmur server (server/index.ts). Copy to .env for local dev; bun loads it automatically.
PORT=8080

# Public origin. Doubles as the WebAuthn relying-party origin, so it must match the address people
# open the app from. Local dev with Vite: http://localhost:5173
SITE_URL=https://murmur.johanboissard.me

# Username of the site owner: may delete anything, receives posts from the single-admin era, and is
# who ADMIN_TOKEN acts as.
OWNER_USERNAME=johan

# Optional. Lets scripts post as the owner: Authorization: Bearer ...
ADMIN_TOKEN=

# Turso. Leave TURSO_DATABASE_URL unset to use a local SQLite file (local.db).
TURSO_DATABASE_URL=libsql://<db>-<org>.turso.io
TURSO_AUTH_TOKEN=

# Cloudflare R2 for preview images (S3 API). Leave unset locally to keep images in Turso.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=perso-blog

# Optional: use a preinstalled Chromium instead of Playwright's own (e.g. /opt/pw-browsers/chromium)
# PLAYWRIGHT_CHROMIUM_PATH=
